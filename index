    <style>
        :root {
            --bg-white: #FFFFFF;
            --bg-light-gray: #F8FAFC;
            --bg-card-gray: #F1F5F9;
            --border-color: #E2E8F0;
            --text-primary: #1E293B;
            --text-secondary: #475569;
            --text-muted: #64748B;
            --accent-blue: #0284C7;
            --accent-blue-hover: #0369A1;
            --accent-amber: #F59E0B;
            --whatsapp-green: #25D366;
            --shadow-sm: 0 1px 3px rgba(0, 0, 0, 0.05);
            --shadow-md: 0 4px 12px rgba(0, 0, 0, 0.06);
            --shadow-lg: 0 10px 25px rgba(0, 0, 0, 0.08);
            --radius-md: 8px;
            --radius-lg: 12px;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
            font-family: 'Inter', 'Noto Sans Arabic', -apple-system, BlinkMacSystemFont, sans-serif;
            color: var(--text-primary);
            background-color: var(--bg-white);
        }

        /* Header & Right-Aligned Navigation */
        header {
            position: sticky;
            top: 0;
            z-index: 1000;
            background-color: rgba(255, 255, 255, 0.96);
            backdrop-filter: blur(8px);
            border-bottom: 1px solid var(--border-color);
            box-shadow: var(--shadow-sm);
        }

        .nav-container {
            max-width: 1280px;
            margin: 0 auto;
            padding: 0 24px;
            height: 76px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .brand-logo {
            display: flex;
            flex-direction: column;
            text-decoration: none;
        }

        .brand-main {
            font-size: 1.35rem;
            font-weight: 700;
            letter-spacing: 0.5px;
            color: var(--text-primary);
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .brand-badge {
            background-color: var(--accent-blue);
            color: #fff;
            font-size: 0.7rem;
            padding: 2px 6px;
            border-radius: 4px;
            font-weight: 600;
        }

        .brand-sub {
            font-size: 0.75rem;
            color: var(--text-muted);
            margin-top: 2px;
        }

        /* Right-aligned Nav Menu */
        .nav-right-wrapper {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            margin-left: auto;
            gap: 28px;
        }

        html[dir="rtl"] .nav-right-wrapper {
            margin-left: 0;
            margin-right: auto;
        }

        .nav-links {
            display: flex;
            list-style: none;
            gap: 24px;
            align-items: center;
        }

        .nav-links a {
            text-decoration: none;
            color: var(--text-primary);
            font-weight: 500;
            font-size: 0.95rem;
            transition: color 0.2s;
            padding: 6px 4px;
            position: relative;
        }

        .nav-links a:hover {
            color: var(--accent-blue);
        }

        .nav-links a::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            width: 0;
            height: 2px;
            background-color: var(--accent-blue);
            transition: width 0.25s ease;
        }

        .nav-links a:hover::after {
            width: 100%;
        }

        /* Language Dropdown */
        .lang-dropdown {
            position: relative;
        }

        .lang-btn {
            background-color: var(--bg-light-gray);
            border: 1px solid var(--border-color);
            color: var(--text-primary);
            padding: 8px 14px;
            border-radius: var(--radius-md);
            font-size: 0.875rem;
            font-weight: 500;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 8px;
            transition: all 0.2s;
        }

        .lang-btn:hover {
            border-color: var(--accent-blue);
            background-color: #fff;
        }

        .lang-menu {
            position: absolute;
            top: calc(100% + 8px);
            right: 0;
            background-color: var(--bg-white);
            border: 1px solid var(--border-color);
            border-radius: var(--radius-md);
            box-shadow: var(--shadow-lg);
            min-width: 150px;
            display: none;
            flex-direction: column;
            overflow: hidden;
            z-index: 1001;
        }

        html[dir="rtl"] .lang-menu {
            right: auto;
            left: 0;
        }

        .lang-menu.show {
            display: flex;
        }

        .lang-option {
            padding: 10px 16px;
            border: none;
            background: none;
            text-align: left;
            font-size: 0.875rem;
            color: var(--text-primary);
            cursor: pointer;
            transition: background 0.15s;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        html[dir="rtl"] .lang-option {
            text-align: right;
        }

        .lang-option:hover {
            background-color: var(--bg-light-gray);
            color: var(--accent-blue);
        }

        .mobile-toggle {
            display: none;
            background: none;
            border: 1px solid var(--border-color);
            padding: 6px 10px;
            border-radius: 6px;
            font-size: 1.2rem;
            cursor: pointer;
            color: var(--text-primary);
        }

        /* Hero 4-Slide Carousel (Light & Clean Style) */
        .hero-carousel {
            position: relative;
            width: 100%;
            height: 560px;
            background-color: var(--bg-light-gray);
            overflow: hidden;
            border-bottom: 1px solid var(--border-color);
        }

        .slides-track {
            display: flex;
            height: 100%;
            transition: transform 0.6s cubic-bezier(0.25, 1, 0.5, 1);
        }

        .slide {
            min-width: 100%;
            height: 100%;
            position: relative;
            display: flex;
            align-items: center;
            background-size: cover;
            background-position: center;
        }

        /* Soft light overlay to keep clean white/light-gray aesthetic while ensuring crisp text legibility */
        .slide::before {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(90deg, rgba(255, 255, 255, 0.94) 0%, rgba(248, 250, 252, 0.85) 55%, rgba(255, 255, 255, 0.35) 100%);
        }

        html[dir="rtl"] .slide::before {
            background: linear-gradient(270deg, rgba(255, 255, 255, 0.94) 0%, rgba(248, 250, 252, 0.85) 55%, rgba(255, 255, 255, 0.35) 100%);
        }

        .slide-content {
            position: relative;
            z-index: 2;
            max-width: 1280px;
            width: 100%;
            margin: 0 auto;
            padding: 0 24px;
        }

        .slide-box {
            max-width: 620px;
        }

        .slide-tag {
            display: inline-block;
            background-color: #E0F2FE;
            color: var(--accent-blue);
            font-size: 0.8rem;
            font-weight: 600;
            padding: 5px 12px;
            border-radius: 20px;
            margin-bottom: 16px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .slide-title {
            font-size: 2.65rem;
            font-weight: 700;
            line-height: 1.2;
            color: var(--text-primary);
            margin-bottom: 16px;
        }

        .slide-desc {
            font-size: 1.05rem;
            line-height: 1.6;
            color: var(--text-secondary);
            margin-bottom: 28px;
        }

        .btn-primary {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background-color: var(--accent-blue);
            color: #fff;
            padding: 13px 26px;
            border-radius: var(--radius-md);
            text-decoration: none;
            font-weight: 600;
            font-size: 0.95rem;
            border: none;
            cursor: pointer;
            transition: background 0.2s, transform 0.15s;
            box-shadow: var(--shadow-sm);
        }

        .btn-primary:hover {
            background-color: var(--accent-blue-hover);
            transform: translateY(-1px);
        }

        .btn-outline {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background-color: #fff;
            color: var(--text-primary);
            border: 1px solid var(--border-color);
            padding: 13px 24px;
            border-radius: var(--radius-md);
            text-decoration: none;
            font-weight: 600;
            font-size: 0.95rem;
            margin-left: 12px;
            transition: all 0.2s;
        }

        .btn-outline:hover {
            border-color: var(--accent-blue);
            color: var(--accent-blue);
        }

        .carousel-arrow {
            position: absolute;
            top: 50%;
            transform: translateY(-50%);
            z-index: 10;
            width: 44px;
            height: 44px;
            border-radius: 50%;
            background-color: rgba(255, 255, 255, 0.9);
            border: 1px solid var(--border-color);
            color: var(--text-primary);
            font-size: 1.2rem;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: var(--shadow-md);
            transition: all 0.2s;
        }

        .carousel-arrow:hover {
            background-color: var(--accent-blue);
            color: #fff;
            border-color: var(--accent-blue);
        }

        .arrow-prev { left: 20px; }
        .arrow-next { right: 20px; }

        .carousel-dots {
            position: absolute;
            bottom: 24px;
            left: 50%;
            transform: translateX(-50%);
            display: flex;
            gap: 10px;
            z-index: 10;
        }

        .dot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            background-color: #CBD5E1;
            border: none;
            cursor: pointer;
            transition: all 0.3s;
        }

        .dot.active {
            width: 28px;
            border-radius: 6px;
            background-color: var(--accent-blue);
        }

        /* Common Section Layout */
        section {
            padding: 80px 24px;
        }

        .section-gray {
            background-color: var(--bg-light-gray);
            border-top: 1px solid var(--border-color);
            border-bottom: 1px solid var(--border-color);
        }

        .container {
            max-width: 1280px;
            margin: 0 auto;
        }

        .section-header {
            text-align: center;
            max-width: 720px;
            margin: 0 auto 52px;
        }

        .section-subtitle {
            color: var(--accent-blue);
            font-weight: 600;
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 8px;
        }

        .section-title {
            font-size: 2rem;
            font-weight: 700;
            color: var(--text-primary);
            margin-bottom: 14px;
        }

        .section-desc {
            color: var(--text-secondary);
            font-size: 1rem;
            line-height: 1.6;
        }

        /* Products Grid */
        .products-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 28px;
        }

        .product-card {
            background-color: var(--bg-white);
            border: 1px solid var(--border-color);
            border-radius: var(--radius-lg);
            overflow: hidden;
            box-shadow: var(--shadow-sm);
            transition: transform 0.25s, box-shadow 0.25s;
            display: flex;
            flex-direction: column;
        }

        .product-card:hover {
            transform: translateY(-5px);
            box-shadow: var(--shadow-lg);
            border-color: #BAE6FD;
        }

        .product-img-wrap {
            height: 210px;
            background-color: var(--bg-card-gray);
            overflow: hidden;
            position: relative;
        }

        .product-img-wrap img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.4s;
        }

        .product-card:hover .product-img-wrap img {
            transform: scale(1.05);
        }

        .product-body {
            padding: 24px;
            flex: 1;
            display: flex;
            flex-direction: column;
        }

        .product-title {
            font-size: 1.2rem;
            font-weight: 700;
            margin-bottom: 10px;
            color: var(--text-primary);
        }

        .product-text {
            font-size: 0.92rem;
            color: var(--text-secondary);
            line-height: 1.6;
            margin-bottom: 20px;
            flex: 1;
        }

        .product-specs {
            background-color: var(--bg-light-gray);
            padding: 10px 14px;
            border-radius: 6px;
            font-size: 0.82rem;
            color: var(--text-muted);
            margin-bottom: 18px;
            border: 1px solid var(--border-color);
        }

        .product-link {
            color: var(--accent-blue);
            font-weight: 600;
            font-size: 0.9rem;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        .product-link:hover {
            text-decoration: underline;
        }

        /* About Section */
        .about-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 48px;
            align-items: center;
        }

        .about-stats {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 20px;
            margin-top: 28px;
        }

        .stat-box {
            background-color: var(--bg-light-gray);
            border: 1px solid var(--border-color);
            padding: 20px;
            border-radius: var(--radius-md);
        }

        .stat-num {
            font-size: 1.75rem;
            font-weight: 700;
            color: var(--accent-blue);
        }

        .stat-label {
            font-size: 0.875rem;
            color: var(--text-secondary);
            margin-top: 4px;
        }

        .about-visual {
            background-color: var(--bg-card-gray);
            border: 1px solid var(--border-color);
            border-radius: var(--radius-lg);
            padding: 28px;
            box-shadow: var(--shadow-md);
        }

        .about-visual img {
            width: 100%;
            border-radius: var(--radius-md);
            display: block;
        }

        /* Blog Section - Direct Jump to Full Article View */
        .blog-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
            gap: 28px;
        }

        .blog-card {
            background-color: var(--bg-white);
            border: 1px solid var(--border-color);
            border-radius: var(--radius-lg);
            padding: 26px;
            box-shadow: var(--shadow-sm);
            transition: all 0.2s;
            display: flex;
            flex-direction: column;
        }

        .blog-card:hover {
            box-shadow: var(--shadow-md);
            border-color: var(--accent-blue);
        }

        .blog-meta {
            font-size: 0.8rem;
            color: var(--text-muted);
            margin-bottom: 10px;
            display: flex;
            gap: 12px;
        }

        .blog-title {
            font-size: 1.18rem;
            font-weight: 700;
            color: var(--text-primary);
            margin-bottom: 12px;
            line-height: 1.4;
        }

        .blog-excerpt {
            font-size: 0.92rem;
            color: var(--text-secondary);
            line-height: 1.6;
            margin-bottom: 20px;
            flex: 1;
        }

        .blog-read-btn {
            align-self: flex-start;
            background-color: var(--bg-light-gray);
            color: var(--accent-blue);
            border: 1px solid var(--border-color);
            padding: 8px 16px;
            border-radius: 6px;
            font-size: 0.875rem;
            font-weight: 600;
            cursor: pointer;
            text-decoration: none;
            transition: all 0.2s;
        }

        .blog-read-btn:hover {
            background-color: var(--accent-blue);
            color: #fff;
            border-color: var(--accent-blue);
        }

        /* Dedicated Article Reader Box (Direct Anchor Target for Blog Links) */
        .article-reader {
            margin-top: 48px;
            background-color: var(--bg-white);
            border: 1px solid #BAE6FD;
            border-radius: var(--radius-lg);
            padding: 36px;
            box-shadow: var(--shadow-md);
            scroll-margin-top: 100px;
        }

        .article-badge {
            display: inline-block;
            background-color: #E0F2FE;
            color: var(--accent-blue);
            font-size: 0.78rem;
            font-weight: 600;
            padding: 4px 10px;
            border-radius: 4px;
            margin-bottom: 12px;
        }

        .article-reader h3 {
            font-size: 1.6rem;
            margin-bottom: 14px;
            color: var(--text-primary);
        }

        .article-reader-body {
            color: var(--text-secondary);
            line-height: 1.8;
            font-size: 0.98rem;
        }

        .article-reader-body p {
            margin-bottom: 14px;
        }

        /* Contact Section */
        .contact-grid {
            display: grid;
            grid-template-columns: 1fr 1.2fr;
            gap: 40px;
        }

        .contact-info-card {
            background-color: var(--bg-light-gray);
            border: 1px solid var(--border-color);
            border-radius: var(--radius-lg);
            padding: 32px;
        }

        .info-item {
            display: flex;
            align-items: flex-start;
            gap: 14px;
            margin-bottom: 22px;
        }

        .info-icon {
            width: 40px;
            height: 40px;
            background-color: #E0F2FE;
            color: var(--accent-blue);
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.1rem;
            flex-shrink: 0;
        }

        .info-label {
            font-size: 0.82rem;
            color: var(--text-muted);
            font-weight: 500;
        }

        .info-val {
            font-size: 1rem;
            color: var(--text-primary);
            font-weight: 600;
            margin-top: 2px;
            word-break: break-all;
        }

        .contact-form {
            background-color: var(--bg-white);
            border: 1px solid var(--border-color);
            border-radius: var(--radius-lg);
            padding: 32px;
            box-shadow: var(--shadow-sm);
        }

        .form-group {
            margin-bottom: 18px;
        }

        .form-group label {
            display: block;
            font-size: 0.88rem;
            font-weight: 600;
            margin-bottom: 6px;
            color: var(--text-primary);
        }

        .form-control {
            width: 100%;
            padding: 11px 14px;
            border: 1px solid var(--border-color);
            border-radius: 6px;
            font-size: 0.95rem;
            font-family: inherit;
            background-color: var(--bg-light-gray);
            transition: border-color 0.2s, background 0.2s;
        }

        .form-control:focus {
            outline: none;
            border-color: var(--accent-blue);
            background-color: #fff;
        }

        /* Light & Clean Footer */
        footer {
            background-color: var(--bg-light-gray);
            border-top: 1px solid var(--border-color);
            padding: 48px 24px 28px;
            color: var(--text-secondary);
        }

